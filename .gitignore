# Files git should never commit.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets never go in the repo; a blank .env.example is fine)
.env*
!.env.example

# personal Claude Code settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python pipeline
pipeline/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
pipeline/dist/
# cached ERDDAP downloads during development
pipeline/.cache/

# MapLibre web worker, copied from node_modules before each build
/public/maplibre/
